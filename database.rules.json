{
  "rules": {
    "wedding": {
      "data": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'cgn210@cgnmail.net' || root.child('wedding/allowed').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'cgn210@cgnmail.net' || root.child('wedding/allowed').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        "guests": {
          "$id": {
            ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0"
          }
        }
      },
      "settings": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'cgn210@cgnmail.net' || root.child('wedding/allowed').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'cgn210@cgnmail.net'"
      },
      "allowed": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'cgn210@cgnmail.net'",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'cgn210@cgnmail.net'"
      }
    }
  }
}
